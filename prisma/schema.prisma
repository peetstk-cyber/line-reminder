datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ReminderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum Recurrence {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum NoteCategory {
  SHOPPING
  TODO
  GENERAL
  LINK
  READING
}

enum DebtType {
  LENT      // เราให้ยืม (เขาติดเรา)
  BORROWED  // เรายืมเขา (เราติดเขา)
}

enum DebtStatus {
  PENDING   // ยังไม่จ่าย
  SETTLED   // เคลียร์แล้ว
}

model User {
  id             String          @id @default(cuid())
  lineUserId     String          @unique
  displayName    String?
  pictureUrl     String?
  createdAt      DateTime        @default(now())
  reminders      Reminder[]
  notes          Note[]
  debts          Debt[]
  personProfiles PersonProfile[]
  shifts         Shift[]

  @@map("users")
}

model Reminder {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskTitle        String
  remindAt         DateTime
  displayDate      String?
  displayTime      String?
  status           ReminderStatus    @default(PENDING)
  recurrence       Recurrence        @default(NONE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  notificationLogs NotificationLog[]

  @@index([userId])
  @@index([remindAt, status])
  @@map("reminders")
}

model Note {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  items     Json         @default("[]")
  category  NoteCategory @default(GENERAL)
  isPinned  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([userId])
  @@index([category])
  @@map("notes")
}

model NotificationLog {
  id         String   @id @default(cuid())
  reminderId String
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  sentAt     DateTime @default(now())
  status     String   // e.g. SUCCESS, FAILED

  @@index([reminderId])
  @@map("notification_logs")
}

model Debt {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  personName  String
  amount      Float
  type        DebtType   @default(LENT)
  description String?
  status      DebtStatus @default(PENDING)
  settledAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([userId, status])
  @@index([userId, personName])
  @@map("debts")
}

model PersonProfile {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  avatarType  String   @default("PRESET_CHARACTER") // PRESET_CHARACTER | CUSTOM_IMAGE
  avatarValue String   @default("cat")              // preset key (fox, cat, bear, ...) or image URL
  color       String   @default("#E8F0E6")          // Pastel hex color
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("person_profiles")
}

model Shift {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String   // "YYYY-MM-DD"
  shiftType String   // "MORNING" | "AFTERNOON" | "NIGHT" | "OFF" | "CUSTOM"
  title     String   // "เช้า", "บ่าย", "ดึก", "ออฟ" etc.
  color     String   @default("#F97316") // Badge color
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, date])
  @@map("shifts")
}


